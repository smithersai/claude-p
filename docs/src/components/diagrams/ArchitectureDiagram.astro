---
interface Props {
  caption?: string;
}
const {
  caption = 'Two OS boundaries keep claude-p deterministic: a real PTY for Ink I/O, and an out-of-band FIFO + JSONL transcript for lifecycle events and output.',
} = Astro.props;
---

<figure class="cp-diagram">
  <svg viewBox="0 0 860 412" role="img" aria-label="claude-p system architecture diagram">
    <defs>
      <marker id="arch-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-border-strong)" />
      </marker>
      <marker id="arch-arrow-accent" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-accent)" />
      </marker>
      <marker id="arch-arrow-blue" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-blue)" />
      </marker>
      <marker id="arch-arrow-green" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-green)" />
      </marker>
    </defs>

    <!-- Outer process container -->
    <rect x="14" y="14" width="572" height="378" rx="12" fill="var(--diag-surface)" stroke="var(--diag-border)" stroke-width="1.5" />
    <text x="30" y="38" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="12" font-weight="700" fill="var(--diag-accent)">
      claude-p process (Zig 0.15.2)
    </text>

    <!-- Main event loop -->
    <rect x="30" y="58" width="232" height="98" rx="8" fill="var(--diag-accent-fill)" stroke="var(--diag-accent)" stroke-width="1.5" />
    <text x="44" y="81" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-text)">driver / daemon loop</text>
    <text x="44" y="101" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-muted)">• startup dialog FSM</text>
    <text x="44" y="119" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-muted)">• paced bracketed paste</text>
    <text x="44" y="137" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-muted)">• watchdogs + FIFO poll</text>

    <!-- zmux NativeSession -->
    <rect x="330" y="58" width="240" height="98" rx="8" fill="var(--diag-blue-fill)" stroke="var(--diag-blue)" stroke-width="1.5" />
    <text x="344" y="81" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-text)">zmux.NativeSession</text>
    <text x="344" y="101" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-muted)">• openpty / forkpty</text>
    <text x="344" y="119" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-muted)">• background reader thread</text>
    <text x="344" y="137" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-muted)">• 8 KB ring + EventSink</text>

    <!-- terminal.zig DEC responder -->
    <rect x="330" y="194" width="240" height="74" rx="8" fill="var(--diag-surface-alt)" stroke="var(--diag-blue)" stroke-width="1.25" stroke-dasharray="4 3" />
    <text x="344" y="217" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12.5" font-weight="700" fill="var(--diag-text)">terminal.zig (reader thread)</text>
    <text x="344" y="236" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-muted)">DA1 · DA2 · DSR · XTVERSION · 18t</text>
    <text x="344" y="254" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-blue)">queues into pending_to_pty</text>

    <!-- stream.zig + transcript.zig + emit.zig -->
    <rect x="30" y="296" width="232" height="78" rx="8" fill="var(--diag-green-fill)" stroke="var(--diag-green)" stroke-width="1.5" />
    <text x="44" y="319" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12.5" font-weight="700" fill="var(--diag-text)">stream · transcript · emit</text>
    <text x="44" y="338" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-muted)">pread Tailer + offset parser</text>
    <text x="44" y="356" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-green)">stdout: text | json | stream-json</text>

    <!-- Hook harness / FIFO -->
    <rect x="330" y="296" width="240" height="78" rx="8" fill="var(--diag-purple-fill)" stroke="var(--diag-purple)" stroke-width="1.5" />
    <text x="344" y="319" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12.5" font-weight="700" fill="var(--diag-text)">hook.zig + events.fifo</text>
    <text x="344" y="338" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-muted)">$TMPDIR/claude-p-pid-rand/</text>
    <text x="344" y="356" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9" fill="var(--diag-purple)">SessionStart · UserPromptSubmit · Stop</text>

    <!-- Child claude process -->
    <rect x="640" y="58" width="206" height="128" rx="10" fill="var(--diag-surface)" stroke="var(--diag-border-strong)" stroke-width="1.5" />
    <text x="656" y="83" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13.5" font-weight="700" fill="var(--diag-text)">child `claude`</text>
    <text x="656" y="103" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-muted)">Interactive Ink TUI</text>
    <text x="656" y="122" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-muted)">--settings '&lt;inline json&gt;'</text>
    <text x="656" y="140" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-muted)">TERM=xterm-256color</text>
    <text x="656" y="158" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-muted)">CLAUDE_P_FIFO=…</text>

    <!-- Transcript file on disk -->
    <rect x="640" y="296" width="206" height="78" rx="10" fill="var(--diag-surface)" stroke="var(--diag-green)" stroke-width="1.5" />
    <text x="656" y="320" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-text)">transcript.jsonl</text>
    <text x="656" y="340" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-muted)">Claude's session log</text>
    <text x="656" y="358" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-green)">appended per message</text>

    <!-- Arrows -->
    <line x1="262" y1="95" x2="327" y2="95" stroke="var(--diag-accent)" stroke-width="1.75" marker-end="url(#arch-arrow-accent)" />
    <text x="295" y="87" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9.5" fill="var(--diag-accent)">writeInput</text>

    <line x1="570" y1="108" x2="637" y2="108" stroke="var(--diag-blue)" stroke-width="1.75" marker-start="url(#arch-arrow-blue)" marker-end="url(#arch-arrow-blue)" />
    <text x="604" y="99" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-blue)">PTY</text>

    <line x1="450" y1="156" x2="450" y2="191" stroke="var(--diag-blue)" stroke-width="1.5" marker-end="url(#arch-arrow-blue)" />
    <text x="458" y="178" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-blue)">pane_output</text>

    <path d="M 330 232 L 160 232 L 160 159" fill="none" stroke="var(--diag-blue)" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#arch-arrow-blue)" />
    <text x="245" y="224" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9.5" fill="var(--diag-blue)">mutex queue (no re-entry)</text>

    <path d="M 692 186 L 692 252 L 604 252 L 604 328 L 573 328" fill="none" stroke="var(--diag-purple)" stroke-width="1.5" marker-end="url(#arch-arrow)" />
    <text x="648" y="244" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-purple)">hook.sh</text>

    <path d="M 330 322 L 296 322 L 296 134 L 265 134" fill="none" stroke="var(--diag-purple)" stroke-width="1.5" marker-end="url(#arch-arrow)" />
    <text x="288" y="280" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9.5" fill="var(--diag-purple)" transform="rotate(-90 288 280)">O_NONBLOCK read</text>

    <line x1="764" y1="186" x2="764" y2="293" stroke="var(--diag-green)" stroke-width="1.75" marker-end="url(#arch-arrow-green)" />
    <text x="772" y="244" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-green)">flush JSONL</text>

    <path d="M 640 356 L 612 356 L 612 402 L 146 402 L 146 377" fill="none" stroke="var(--diag-green)" stroke-width="1.75" marker-end="url(#arch-arrow-green)" />
    <text x="394" y="396" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-green)">pread() tailer &amp; parseFileFromOffset()</text>

    <line x1="94" y1="156" x2="94" y2="293" stroke="var(--diag-accent)" stroke-width="1.5" marker-end="url(#arch-arrow-accent)" />
    <text x="86" y="226" text-anchor="end" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-accent)">on Stop</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
