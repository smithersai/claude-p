---
interface Props {
  caption?: string;
}
const {
  caption = 'Ink probes the terminal at startup. The reader thread scans raw bytes without locking zmux, queues replies across write_mutex, and the main loop writes them back.',
} = Astro.props;
---

<figure class="cp-diagram">
  <svg viewBox="0 0 820 340" role="img" aria-label="DEC and XTerm query handshake sequence diagram">
    <defs>
      <marker id="dec-arr-b" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-blue)" />
      </marker>
      <marker id="dec-arr-a" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-accent)" />
      </marker>
      <marker id="dec-arr-g" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-green)" />
      </marker>
    </defs>

    <!-- Swimlane headers -->
    <rect x="24" y="16" width="160" height="38" rx="8" fill="var(--diag-surface)" stroke="var(--diag-border-strong)" stroke-width="1.5" />
    <text x="104" y="40" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-text)">claude (Ink TUI)</text>

    <rect x="280" y="16" width="220" height="38" rx="8" fill="var(--diag-blue-fill)" stroke="var(--diag-blue)" stroke-width="1.5" />
    <text x="390" y="40" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-text)">zmux reader + terminal.zig</text>

    <rect x="596" y="16" width="200" height="38" rx="8" fill="var(--diag-accent-fill)" stroke="var(--diag-accent)" stroke-width="1.5" />
    <text x="696" y="40" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-text)">driver main loop</text>

    <!-- Lifelines -->
    <line x1="104" y1="54" x2="104" y2="322" stroke="var(--diag-border)" stroke-width="1.5" stroke-dasharray="5 4" />
    <line x1="390" y1="54" x2="390" y2="322" stroke="var(--diag-border)" stroke-width="1.5" stroke-dasharray="5 4" />
    <line x1="696" y1="54" x2="696" y2="322" stroke="var(--diag-border)" stroke-width="1.5" stroke-dasharray="5 4" />

    <!-- Step 1: Ink emits probes -->
    <line x1="104" y1="90" x2="384" y2="90" stroke="var(--diag-blue)" stroke-width="1.8" marker-end="url(#dec-arr-b)" />
    <text x="244" y="82" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" fill="var(--diag-text)">ESC[c   ESC[&gt;c   ESC[6n   ESC[&gt;q   ESC[18t</text>

    <!-- Step 2: Reader scans & queues -->
    <rect x="292" y="108" width="196" height="44" rx="6" fill="var(--diag-surface)" stroke="var(--diag-blue)" stroke-width="1.25" />
    <text x="390" y="126" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" fill="var(--diag-blue)">DecDecoder.feed()</text>
    <text x="390" y="143" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11" fill="var(--diag-muted)">pure scan, zero PTY writes</text>

    <!-- Step 3: Push to pending_to_pty -->
    <line x1="390" y1="176" x2="690" y2="176" stroke="var(--diag-accent)" stroke-width="1.8" marker-end="url(#dec-arr-a)" />
    <text x="540" y="168" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" fill="var(--diag-accent)">append under write_mutex</text>

    <!-- Step 4: Main loop flushes back -->
    <rect x="606" y="192" width="180" height="40" rx="6" fill="var(--diag-surface)" stroke="var(--diag-accent)" stroke-width="1.25" />
    <text x="696" y="210" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" fill="var(--diag-accent)">flushPendingToPty()</text>
    <text x="696" y="225" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">stack 512 B buffer, 0 allocs</text>

    <line x1="696" y1="256" x2="110" y2="256" stroke="var(--diag-green)" stroke-width="1.8" marker-end="url(#dec-arr-g)" />
    <text x="402" y="248" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" fill="var(--diag-green)">ESC[?1;2c · ESC[&gt;0;0;0c · ESC[1;1R · ESC P&gt;|claude-p ESC\ · ESC[8;40;120t</text>

    <!-- Step 5: Ink unblocks -->
    <rect x="28" y="274" width="152" height="36" rx="6" fill="var(--diag-green-fill)" stroke="var(--diag-green)" stroke-width="1.25" />
    <text x="104" y="296" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="11.5" font-weight="700" fill="var(--diag-green)">Ink boots &amp; renders</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
