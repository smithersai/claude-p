---
interface Props {
  caption?: string;
}
const {
  caption = 'macOS drops bytes written past its 1024-byte TTYHOG PTY input queue. PasteChunker splits prompts into ≤ 512 B UTF-8-safe chunks inside DECSET 2004 bracketed paste, pauses 120 ms for Ink, then watches for acceptance.',
} = Astro.props;
---

<figure class="cp-diagram">
  <svg viewBox="0 0 820 300" role="img" aria-label="Paced bracketed paste and prompt acceptance watchdog diagram">
    <defs>
      <marker id="pst-arr" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-border-strong)" />
      </marker>
      <marker id="pst-arr-r" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-rose)" />
      </marker>
    </defs>

    <!-- TTYHOG ceiling reference line -->
    <text x="24" y="28" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" font-weight="700" fill="var(--diag-muted)">
      WIRE STREAM WRITTEN TO PTY (DECSET 2004 BRACKETED PASTE)
    </text>

    <!-- Byte packets -->
    <rect x="24" y="46" width="92" height="54" rx="7" fill="var(--diag-purple-fill)" stroke="var(--diag-purple)" stroke-width="1.5" />
    <text x="70" y="70" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11.5" font-weight="700" fill="var(--diag-purple)">ESC[200~</text>
    <text x="70" y="88" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">paste start</text>

    <rect x="132" y="46" width="136" height="54" rx="7" fill="var(--diag-blue-fill)" stroke="var(--diag-blue)" stroke-width="1.5" />
    <text x="200" y="70" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11.5" font-weight="700" fill="var(--diag-text)">Chunk 1 (≤512 B)</text>
    <text x="200" y="88" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-blue)">UTF-8 boundary safe</text>

    <text x="292" y="77" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10" fill="var(--diag-accent)">8 ms</text>

    <rect x="316" y="46" width="136" height="54" rx="7" fill="var(--diag-blue-fill)" stroke="var(--diag-blue)" stroke-width="1.5" />
    <text x="384" y="70" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11.5" font-weight="700" fill="var(--diag-text)">Chunk N (≤512 B)</text>
    <text x="384" y="88" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-blue)">strips embedded 201~</text>

    <rect x="468" y="46" width="92" height="54" rx="7" fill="var(--diag-purple-fill)" stroke="var(--diag-purple)" stroke-width="1.5" />
    <text x="514" y="70" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11.5" font-weight="700" fill="var(--diag-purple)">ESC[201~</text>
    <text x="514" y="88" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">paste end</text>

    <rect x="576" y="54" width="96" height="38" rx="6" fill="var(--diag-accent-fill)" stroke="var(--diag-accent)" stroke-width="1.25" stroke-dasharray="3 3" />
    <text x="624" y="71" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-accent)">sleep 120 ms</text>
    <text x="624" y="85" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9.5" fill="var(--diag-muted)">Ink debounce</text>

    <rect x="688" y="46" width="108" height="54" rx="7" fill="var(--diag-green-fill)" stroke="var(--diag-green)" stroke-width="1.5" />
    <text x="742" y="70" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="12" font-weight="700" fill="var(--diag-green)">\r (Enter)</text>
    <text x="742" y="88" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">submits once</text>

    <!-- Arrows between packets -->
    <line x1="116" y1="73" x2="129" y2="73" stroke="var(--diag-border-strong)" stroke-width="1.5" marker-end="url(#pst-arr)" />
    <line x1="452" y1="73" x2="465" y2="73" stroke="var(--diag-border-strong)" stroke-width="1.5" marker-end="url(#pst-arr)" />
    <line x1="560" y1="73" x2="573" y2="73" stroke="var(--diag-border-strong)" stroke-width="1.5" marker-end="url(#pst-arr)" />
    <line x1="672" y1="73" x2="685" y2="73" stroke="var(--diag-border-strong)" stroke-width="1.5" marker-end="url(#pst-arr)" />

    <!-- Watchdog section -->
    <line x1="24" y1="128" x2="796" y2="128" stroke="var(--diag-border)" stroke-width="1" stroke-dasharray="4 4" />
    <text x="24" y="150" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" font-weight="700" fill="var(--diag-muted)">
      POST-SUBMIT VERIFICATION &amp; WATCHDOG (ONE-SHOT MODE)
    </text>

    <!-- Accepted box -->
    <rect x="24" y="168" width="240" height="106" rx="8" fill="var(--diag-green-fill)" stroke="var(--diag-green)" stroke-width="1.5" />
    <text x="38" y="191" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12.5" font-weight="700" fill="var(--diag-green)">Accepted (proceed to Stop)</text>
    <text x="38" y="211" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-text)">• UserPromptSubmit arrives</text>
    <text x="38" y="229" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-text)">• OR transcript grows &gt; offset</text>
    <text x="38" y="253" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">Also verifies non-space byte count</text>
    <text x="38" y="267" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">if prompt &gt; 64 non-space bytes.</text>

    <!-- Truncated box -->
    <rect x="288" y="168" width="224" height="106" rx="8" fill="var(--diag-rose-fill)" stroke="var(--diag-rose)" stroke-width="1.5" />
    <text x="302" y="191" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12.5" font-weight="700" fill="var(--diag-rose)">Truncated (fail fast)</text>
    <text x="302" y="211" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-text)">received_non_ws &lt; expected</text>
    <text x="302" y="229" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">(ignores [Pasted text #…] and</text>
    <text x="302" y="244" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">&lt;pasted_content placeholders)</text>
    <text x="302" y="264" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-rose)">→ RunError.PromptTruncated</text>

    <!-- Watchdog retry box -->
    <rect x="536" y="168" width="260" height="106" rx="8" fill="var(--diag-accent-fill)" stroke="var(--diag-accent)" stroke-width="1.5" />
    <text x="550" y="191" font-family="ui-sans-serif, system-ui, sans-serif" font-size="12.5" font-weight="700" fill="var(--diag-accent)">Silent &gt; 4000 ms (reinject)</text>
    <text x="550" y="211" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-text)">1. Send Ctrl-U (\x15) to clear</text>
    <text x="550" y="229" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-text)">2. Wait for Ink quiescence</text>
    <text x="550" y="247" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-text)">3. Re-run typePrompt (max 4×)</text>
    <text x="550" y="264" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-rose)">4th miss → PromptNotAccepted</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
