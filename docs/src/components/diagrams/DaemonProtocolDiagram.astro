---
interface Props {
  caption?: string;
}
const {
  caption = 'claude-p daemon keeps one interactive Claude session open across turns. ping is answered inline; interrupt cancels a busy turn without killing the session; dual busy watchdogs emit structured error frames before exiting.',
} = Astro.props;
---

<figure class="cp-diagram">
  <svg viewBox="0 0 860 364" role="img" aria-label="Daemon mode NDJSON protocol and state machine diagram">
    <defs>
      <marker id="dmn-arr" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-border-strong)" />
      </marker>
      <marker id="dmn-arr-b" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-blue)" />
      </marker>
      <marker id="dmn-arr-g" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-green)" />
      </marker>
    </defs>

    <!-- Left column: Stdin frames -->
    <rect x="14" y="18" width="246" height="328" rx="10" fill="var(--diag-surface)" stroke="var(--diag-blue)" stroke-width="1.5" />
    <text x="28" y="42" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-blue)">stdin (NDJSON)</text>

    <rect x="26" y="56" width="222" height="64" rx="7" fill="var(--diag-blue-fill)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="38" y="75" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-text)">&lbrace;"type":"user", ...&rbrace;</text>
    <text x="38" y="93" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">Queued; submitted via paced</text>
    <text x="38" y="109" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">bracketed paste when idle.</text>

    <rect x="26" y="130" width="222" height="54" rx="7" fill="var(--diag-surface-alt)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="38" y="149" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-text)">&lbrace;"type":"ping"&rbrace;</text>
    <text x="38" y="168" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">Answered inline in any state.</text>

    <rect x="26" y="194" width="222" height="64" rx="7" fill="var(--diag-rose-fill)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="38" y="213" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-rose)">&lbrace;"type":"interrupt"&rbrace;</text>
    <text x="38" y="231" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">Sends ESC while busy; keeps</text>
    <text x="38" y="247" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">session open for next turn.</text>

    <rect x="26" y="268" width="222" height="64" rx="7" fill="var(--diag-surface-alt)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="38" y="287" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-text)">EOF (stdin closed)</text>
    <text x="38" y="305" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">Drains active turn + queue,</text>
    <text x="38" y="320" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">terminates child, exits 0.</text>

    <!-- Middle column: State machine -->
    <rect x="304" y="18" width="252" height="328" rx="10" fill="var(--diag-surface)" stroke="var(--diag-accent)" stroke-width="1.5" />
    <text x="320" y="42" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-accent)">daemon state loop</text>

    <rect x="320" y="58" width="220" height="48" rx="7" fill="var(--diag-surface-alt)" stroke="var(--diag-border-strong)" stroke-width="1.25" />
    <text x="430" y="78" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11.5" font-weight="700" fill="var(--diag-text)">waiting_for_ready</text>
    <text x="430" y="95" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">--timeout (300 s → exit 2)</text>

    <rect x="320" y="138" width="220" height="48" rx="7" fill="var(--diag-green-fill)" stroke="var(--diag-green)" stroke-width="1.5" />
    <text x="430" y="158" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11.5" font-weight="700" fill="var(--diag-green)">idle</text>
    <text x="430" y="175" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">watchdogs paused while parked</text>

    <rect x="320" y="222" width="220" height="104" rx="7" fill="var(--diag-accent-fill)" stroke="var(--diag-accent)" stroke-width="1.5" />
    <text x="430" y="242" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11.5" font-weight="700" fill="var(--diag-accent)">busy</text>
    <text x="430" y="261" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-text)">--idle-timeout (180 s PTY)</text>
    <text x="430" y="278" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-text)">--transcript-idle-timeout (600 s)</text>
    <text x="430" y="296" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">spinner-immune · exit 124</text>
    <text x="430" y="313" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9.5" fill="var(--diag-rose)">ESC → 1.5 s window → idle</text>

    <!-- State transitions -->
    <line x1="430" y1="106" x2="430" y2="135" stroke="var(--diag-border-strong)" stroke-width="1.5" marker-end="url(#dmn-arr)" />
    <text x="438" y="125" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9.5" fill="var(--diag-muted)">SessionStart</text>

    <line x1="382" y1="186" x2="382" y2="219" stroke="var(--diag-accent)" stroke-width="1.5" marker-end="url(#dmn-arr)" />
    <text x="374" y="207" text-anchor="end" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9.5" fill="var(--diag-accent)">dequeue</text>

    <line x1="478" y1="222" x2="478" y2="189" stroke="var(--diag-green)" stroke-width="1.5" marker-end="url(#dmn-arr-g)" />
    <text x="486" y="207" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9.5" fill="var(--diag-green)">Stop / ESC</text>

    <!-- Right column: Stdout frames -->
    <rect x="600" y="18" width="246" height="328" rx="10" fill="var(--diag-surface)" stroke="var(--diag-green)" stroke-width="1.5" />
    <text x="614" y="42" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-green)">stdout (NDJSON)</text>

    <rect x="612" y="56" width="222" height="46" rx="7" fill="var(--diag-surface-alt)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="624" y="75" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-text)">system / init</text>
    <text x="624" y="92" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">Once on SessionStart + session_id</text>

    <rect x="612" y="110" width="222" height="46" rx="7" fill="var(--diag-green-fill)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="624" y="129" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-text)">transcript lines (raw)</text>
    <text x="624" y="146" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">Live stream via pread Tailer</text>

    <rect x="612" y="164" width="222" height="48" rx="7" fill="var(--diag-surface-alt)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="624" y="183" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-text)">&lbrace;"type":"result", ...&rbrace;</text>
    <text x="624" y="200" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">Turn slice [start..end) on Stop</text>

    <rect x="612" y="220" width="222" height="46" rx="7" fill="var(--diag-surface-alt)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="624" y="239" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-text)">&lbrace;"type":"pong","ts":…&rbrace;</text>
    <text x="624" y="256" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">Immediate reply to ping</text>

    <rect x="612" y="274" width="222" height="58" rx="7" fill="var(--diag-rose-fill)" stroke="var(--diag-border)" stroke-width="1" />
    <text x="624" y="293" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" font-weight="700" fill="var(--diag-rose)">interrupted / error result</text>
    <text x="624" y="311" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10" fill="var(--diag-muted)">Structured reason before exit</text>
    <text x="624" y="325" font-family="ui-sans-serif, system-ui, sans-serif" font-size="9.5" fill="var(--diag-muted)">is_error: false on interrupted</text>

    <!-- Connector arrows -->
    <line x1="260" y1="182" x2="301" y2="182" stroke="var(--diag-blue)" stroke-width="1.8" marker-end="url(#dmn-arr-b)" />
    <line x1="556" y1="182" x2="597" y2="182" stroke="var(--diag-green)" stroke-width="1.8" marker-end="url(#dmn-arr-g)" />
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
