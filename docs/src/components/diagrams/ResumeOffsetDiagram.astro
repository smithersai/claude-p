---
interface Props {
  caption?: string;
}
const {
  caption = 'On --resume or --continue, claude-p snapshots the transcript byte size before typing the new prompt and parses only [offset..EOF), so historical turns can never satisfy the current turn.',
} = Astro.props;
---

<figure class="cp-diagram">
  <svg viewBox="0 0 820 230" role="img" aria-label="Transcript byte offset isolation diagram for resumed sessions">
    <defs>
      <marker id="res-arr" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
        <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="var(--diag-accent)" />
      </marker>
    </defs>

    <text x="24" y="28" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11.5" font-weight="700" fill="var(--diag-muted)">
      ~/.claude/projects/…/&lt;session-id&gt;.jsonl
    </text>

    <!-- Historical bytes -->
    <rect x="24" y="48" width="356" height="66" rx="8" fill="var(--diag-surface-alt)" stroke="var(--diag-border)" stroke-width="1.5" />
    <text x="202" y="76" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-muted)">Historical turns (skipped)</text>
    <text x="202" y="96" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-muted)">bytes [0 .. pre_prompt_transcript_offset)</text>

    <!-- Appended bytes -->
    <rect x="384" y="48" width="412" height="66" rx="8" fill="var(--diag-green-fill)" stroke="var(--diag-green)" stroke-width="1.75" />
    <text x="590" y="76" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--diag-green)">Current turn (tailed &amp; parsed)</text>
    <text x="590" y="96" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-text)">bytes [pre_prompt_transcript_offset .. EOF)</text>

    <!-- Offset pointer -->
    <line x1="382" y1="36" x2="382" y2="146" stroke="var(--diag-accent)" stroke-width="2" stroke-dasharray="4 3" />
    <circle cx="382" cy="146" r="4" fill="var(--diag-accent)" />
    <rect x="234" y="156" width="296" height="54" rx="7" fill="var(--diag-accent-fill)" stroke="var(--diag-accent)" stroke-width="1.25" />
    <text x="382" y="178" text-anchor="middle" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="11" font-weight="700" fill="var(--diag-accent)">stat(transcript_path).size</text>
    <text x="382" y="197" text-anchor="middle" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-text)">Recorded right before typePrompt(); Tailer starts here</text>

    <!-- Retry note -->
    <text x="554" y="176" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="10.5" fill="var(--diag-green)">On Stop:</text>
    <text x="554" y="193" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">parseFileFromOffset() retries 20×50 ms</text>
    <text x="554" y="208" font-family="ui-sans-serif, system-ui, sans-serif" font-size="10.5" fill="var(--diag-muted)">(up to 30× on Stop-text mismatch)</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
